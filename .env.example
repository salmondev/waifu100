# Copy to .env.local for development, and set the same names in Vercel.

# Redis connection string for shares and the community feed.
REDIS_URL=

# Google Gemini, used by the AI verdict and suggestions.
GEMINI_API_KEY=

# Serper (Google Images) for the character gallery. Metered - the gallery
# degrades to its keyless sources when this runs out.
SERPER_API_KEY=

# Vercel Blob, for share thumbnails and uploaded character images.
BLOB_READ_WRITE_TOKEN=

# Shared secret for admin-only endpoints and debug output. Send it as the
# `x-admin-token` header. Without it set, those routes refuse everyone.
#   - POST /api/images          (unused by the app, spends Gemini + Google CSE)
#   - POST /api/serper-images   (unused by the app, spends Serper credit)
#   - PATCH /api/share/verdict  (only to REPLACE a verdict that already exists)
#   - ?debug output on /api/gallery and /api/share/image/[id]
ADMIN_TOKEN=

# Google Custom Search, only used by the admin-gated /api/images route.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
