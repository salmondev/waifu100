{
  "name": "waifu100",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "precheck": "npx tsc --noEmit && bun run build",
    "migrate:verdicts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/migrate-verdicts.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:integration": "vitest run -c vitest.integration.config.mts",
    "verify": "node scripts/verify.mjs",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:secrets": "node scripts/secret-scan.mjs",
    "security:headers": "node scripts/check-headers.mjs",
    "bundle:budget": "node scripts/bundle-budget.mjs",
    "gacha:catalog": "node scripts/gacha/build-catalog.mjs"
  },
  "dependencies": {
    "@animate-ui/react": "^2.3.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@vercel/blob": "^2.1.0",
    "clsx": "^2.1.1",
    "effect": "^4.0.3",
    "google-auth-library": "^10.5.0",
    "html-to-image": "^1.11.13",
    "ioredis": "^5.9.2",
    "lucide-react": "^0.563.0",
    "lz-string": "^1.5.0",
    "motion": "^14.6.0",
    "nanoid": "^5.1.6",
    "next": "16.4.2",
    "puppeteer": "^24.37.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.4.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.2",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "happy-dom": "^20.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
